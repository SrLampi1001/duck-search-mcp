# duck-search-mcp environment variables.
# Copy to `.env` (gitignored) and fill in any overrides. No API key is required.

# Transport: "http" (Streamable HTTP, default) or "stdio".
DUCK_SEARCH_TRANSPORT=http

# Bind address when transport=http. Loopback only by design; VS Code's
# "Forward a Port" tunnels this through Microsoft's relay. See docs/DEPLOYMENT.md.
DUCK_SEARCH_HOST=127.0.0.1
DUCK_SEARCH_PORT=8000

# Path prefix for the Streamable HTTP endpoint. Clients must include this in the URL.
DUCK_SEARCH_PATH=/mcp

# On-disk cache directory for DDG responses.
DDG_CACHE_DIR=./cache/ddg

# Cache freshness in seconds. 0 disables the cache.
DDG_CACHE_TTL_SECS=86400

# Minimum spacing between upstream DDG calls in milliseconds. Concurrent calls queue.
DDG_MIN_INTERVAL_MS=1100

# Upstream HTTP request timeout in seconds.
DDG_HTTP_TIMEOUT_S=10

# Log level. Accepted: DEBUG, INFO, WARNING, ERROR. Logs go to stderr.
# Accepts both MCP_LOG_LEVEL (legacy) and FASTMCP_LOG_LEVEL (FastMCP 4 default).
MCP_LOG_LEVEL=WARNING
